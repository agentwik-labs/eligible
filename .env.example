# Copy to .env (gitignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Models: Haiku reads receipts (M5 iteration 4), Sonnet decides, Haiku judges
ELIGIBLE_EXTRACT_MODEL=claude-haiku-5-5
ELIGIBLE_DECIDE_MODEL=claude-sonnet-5-5
ELIGIBLE_JUDGE_MODEL=claude-haiku-5-5
ELIGIBLE_EFFORT=low

# live | record (response cache, API on miss) | replay (cache only, no network)
ELIGIBLE_LLM_MODE=record
# auto: Anthropic API when ANTHROPIC_API_KEY is set, else the Claude Code CLI (no key needed)
ELIGIBLE_LLM_BACKEND=auto
ELIGIBLE_LLM_CACHE_DIR=evals/.cache
ELIGIBLE_BUDGET_USD=10
ELIGIBLE_LEDGER_PATH=logs/llm_calls.jsonl

# Optional tracing (M7). The app runs without these.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
